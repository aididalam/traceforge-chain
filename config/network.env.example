# TraceForge Chain
# Copy this file to config/network.env before running the network.

# Besu
BESU_IMAGE=hyperledger/besu:26.9.0

# Blockchain identity
CHAIN_ID=9009

# QBFT consensus
VALIDATOR_COUNT=4
BLOCK_PERIOD_SECONDS=2
REQUEST_TIMEOUT_SECONDS=4
EPOCH_LENGTH=30000
BLOCK_REWARD=0

# Block capacity
BLOCK_GAS_LIMIT=0x1c9c380

# Free-gas network
ZERO_BASE_FEE=true
MIN_GAS_PRICE=0

# RPC
RPC_PORT=8545

# P2P
P2P_PORT=30303

# Docker-internal network
DOCKER_NETWORK_NAME=traceforge-network
DOCKER_SUBNET=172.28.90.0/24

VALIDATOR1_IP=172.28.90.11
VALIDATOR2_IP=172.28.90.12
VALIDATOR3_IP=172.28.90.13
VALIDATOR4_IP=172.28.90.14
