# Joining host: use the parent repository and copy to .traceforge-deploy/node.env.
TRACEFORGE_PROJECT=traceforge-node
TRACEFORGE_DOCKER_CONTEXT=default
TRACEFORGE_DATA_DIR=/srv/traceforge-node
TRACEFORGE_IMAGE_NAMESPACE=aididalam
TRACEFORGE_VERSION=v0.1.0
TRACEFORGE_IMAGE_MODE=pull
# UID/GID default to the command runner. Keep the private data on this host.
TRACEFORGE_CHAIN_ID=9009
TRACEFORGE_JOIN_BUNDLE_FILE=.traceforge-deploy/join-network.json
# Optional API download. Transfer this dedicated token securely, never in the URL.
TRACEFORGE_JOIN_BUNDLE_URL=
TRACEFORGE_JOIN_TOKEN_FILE=.traceforge-deploy/network-bootstrap-token
# Optional identity supplied independently by your infrastructure operator.
TRACEFORGE_EXPECTED_GENESIS_HASH=
TRACEFORGE_BESU_IMAGE=hyperledger/besu:26.9.0
TRACEFORGE_BESU_STORAGE_FORMAT=BONSAI
TRACEFORGE_BESU_JAVA_OPTS=-Xmx256m
TRACEFORGE_BESU_MEMORY=512m
# Set both to this machine's reachable LAN/VPN IP, not a Docker bridge address.
TRACEFORGE_P2P_BIND=192.168.1.20
TRACEFORGE_P2P_ADVERTISE_HOST=192.168.1.20
TRACEFORGE_NODE_P2P_PORT=30307
TRACEFORGE_NODE_RPC_PORT=18545
