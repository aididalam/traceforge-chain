# TraceForge Chain
# Copy this file to config/network.env before generating a network.

# Besu
BESU_IMAGE=hyperledger/besu:26.9.0

# Blockchain identity
CHAIN_ID=1337

# QBFT consensus
VALIDATOR_COUNT=4
BLOCK_PERIOD_SECONDS=2
REQUEST_TIMEOUT_SECONDS=4
EPOCH_LENGTH=30000
BLOCK_REWARD=0

# Block capacity
BLOCK_GAS_LIMIT=0x1c9c380

# Free-gas network
ZERO_BASE_FEE=true
MIN_GAS_PRICE=0

# RPC
RPC_PORT=8545

# Docker
DOCKER_NETWORK_NAME=traceforge-network
